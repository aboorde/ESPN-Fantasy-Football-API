# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage directory used by tools like istanbul
coverage
docs

.npm
node_modules/

# Optional eslint cache
.cspellcache
.eslintcache

# dotenv environment variables file. The integration tests read ESPN_S2 and SWID from here, so
# every variant is ignored rather than just `.env` -- this repository is public, and a stray
# `.env.local` is how the credentials those tests need end up in it.
.env
.env.*
!.env.example

.DS_Store

# npm pack output
*.tgz

# Build output. Not committed: `prepare` rebuilds it during `npm install`, including when this repo
# is installed as a git dependency, so a consumer always gets artifacts matching the pinned commit.
# Committing them meant they could drift from src/ -- and they did, in 9 of 25 consecutive commits.
node.js
node.js.map
node.js.LICENSE.txt
node-dev.js
node.d.ts
types/
